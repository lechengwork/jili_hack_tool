# Large network-capture logs (exceed GitHub's file size limits)
games/696/netlog.json
games/696/netlog_live.json

# Chrome SafeBrowsing telemetry captured during the site mirror.
# Filename contains ":" which is illegal on Windows and breaks checkout.
game_site_backup/safebrowsing.googleapis.com/

# --- Local build/run artifacts (never upload) ---
# Python bytecode cache — regenerated on every run.
__pycache__/
*.pyc

# Replay temp: generated by `replay.ps1 -Source math` from games/696/math/.
# Regenerated each run; do not upload.
games/696/webcap/spins_from_math/

# 124 live-decode outputs (per-round dumps + side-log) — local only.
games/124/ws_rounds/
games/124/webcap_ws.jsonl

# Fetched game image assets (missing .webp, re-fetchable with BR VPN).
# NOTE: 68 .webp in this tree ARE tracked; these are only the extra ones
# fetched locally. If the team wants them in the repo, `git add -f` them.
dist124/static/annin/3.8/web-mobile/assets/**/*.webp
