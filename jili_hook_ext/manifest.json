{
  "manifest_version": 3,
  "name": "JILI crypto hook",
  "version": "1.0",
  "description": "\u6514\u622a WebCrypto \u4ee5\u9084\u539f /fg5/req \u52a0\u89e3\u5bc6",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.jlfafafa1.com/*",
    "https://*.jlfafafa3.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jlfafafa3.com/*",
        "https://*.jlfafafa1.com/*",
        "http://localhost/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.jlfafafa3.com/*",
        "https://*.jlfafafa1.com/*",
        "http://localhost/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}